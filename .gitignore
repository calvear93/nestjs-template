# artifacts
dist
build

# dependency directories
node_modules
.pnp.cjs

# TypeScript cache
*.tsbuildinfo

# Vite cache
vite.config.ts.*
vitest.config.ts.*
vite.config.js.timestamp-*


# test reports and coverage directory
.reports
.coverage
__reports__
coverage

# npm cache directory
.npm

# linters cache
.eslintcache
.prettiercache

# REPL history
.node_repl_history

# dotenv environment variable files
.env
.env.*

# Mac OS
.DS_Store

# Windows: Explorer metadata, and the `nul` file a `2>nul` redirect leaves behind when a POSIX
# shell runs it (git can't index it, so `git add -A` fails)
Thumbs.db
desktop.ini
nul

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# logs
logs
*.log
debug.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# merge / patch leftovers (mergetool backups, `git apply --reject`)
*.orig
*.rej

# diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# runtime data
pids
*.pid
*.seed
*.pid.lock

# AI assistants — local / temporary artifacts only.
# The repo intentionally versions its shared AI files (do NOT ignore these):
#   .ai/, CLAUDE.md, GEMINI.md, AGENTS.md, docs/changes/,
#   .github/instructions/

# Claude Code (local settings + local memory + runtime locks; shared CLAUDE.md/.claude config stay tracked)
.claude/settings.local.json
.claude/*.local.json
CLAUDE.local.md
.claude/scheduled_tasks.lock

# Claude Code worktrees (`claude --worktree`, isolated subagents): whole checkouts of the repo
/.claude/worktrees/

# Gemini CLI (local state; shared context lives in the tracked GEMINI.md)
.gemini/
GEMINI.local.md

# GitHub Copilot (local CLI state)
.copilot/

# OpenAI Codex CLI
.codex/

# Cursor / Windsurf / Codeium
.cursor/
.windsurf/
.codeium/

# Continue
.continue/

# Aider (chat history, input history, tags cache)
.aider*

# plans handed between AI sessions, written at the repo root (PLAN-<date>-<slug>.md)
/PLAN-*
