{
	"$schema": "https://json.schemastore.org/package.json",
	"version": "0.0.1",
	"project": "(((project-name)))",
	"name": "(((app-name)))",
	"title": "(((app-title)))",
	"description": "(((app-description)))",
	"scripts": {
		"start:dev": "env -m debug --log debug : vite-node --watch src/main.ts",
		"start:release": "env -m debug : vite-node --watch src/main.ts",
		"build": "env -m build : vite build",
		"preview": "pnpm build && env -e dev -m build : node dist/main",
		"test:dev": "env -m test : vitest",
		"test:release": "env -m test : vitest",
		"test:bench": "vitest bench",
		"env:schema": "env schema -e dev -m build",
		"lint": "eslint --cache --cache-location node_modules/.cache/eslint/",
		"format": "prettier --cache --write **/*.{ts,cts,mts,json,md,yml,yaml}",
		"clean": "pnpx del-cli dist .reports **/*.tsbuildinfo .node_modules"
	},
	"imports": {
		"#libs/zod": "./src/libs/zod/index.ts",
		"#libs/http": "./src/libs/http/index.ts",
		"#libs/decorators": "./src/libs/decorators/index.ts",
		"#testing": "./src/__tests__/index.ts"
	},
	"dependencies": {
		"@fastify/static": "10.1.10",
		"@nestjs/common": "12.3.3",
		"@nestjs/core": "12.3.3",
		"@nestjs/platform-fastify": "12.3.3",
		"@nestjs/swagger": "12.1.0",
		"fastify": "5.12.8",
		"luxon": "3.7.2",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"tslib": "2.9.1",
		"zod": "4.6.7",
		"zod-openapi": "6.0.2"
	},
	"devDependencies": {
		"@calvear/env": "3.5.0",
		"@nestjs/testing": "12.3.3",
		"@types/eslint": "9.6.1",
		"@types/luxon": "3.7.6",
		"@types/node": "26.6.6",
		"@vitest/coverage-v8": "5.1.0",
		"@vitest/eslint-plugin": "1.6.28",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-perfectionist": "5.13.0",
		"eslint-plugin-prettier": "5.5.7",
		"eslint-plugin-promise": "7.3.0",
		"eslint-plugin-regexp": "3.3.3",
		"eslint-plugin-sonarjs": "4.2.2",
		"eslint-plugin-unicorn": "79.0.0",
		"globals": "17.14.0",
		"prettier": "3.9.10",
		"type-fest": "5.10.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.6",
		"vite-node": "6.0.0",
		"vitest": "5.1.0",
		"vitest-mock-extended": "5.1.1"
	},
	"type": "module",
	"engines": {
		"node": ">=24",
		"pnpm": ">=12"
	},
	"packageManager": "pnpm@12.18.0",
	"license": "MIT",
	"repository": "https://github.com/calvear93/nestjs-template",
	"keywords": [
		"nest",
		"fastify",
		"pnpm",
		"vite",
		"vitest",
		"typescript"
	]
}
